# LLM API Keys (set at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Local model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM provider: claude | openai | groq | ollama
DEFAULT_LLM_PROVIDER=claude
DEFAULT_MODEL=claude-sonnet-4-20250514

# Embeddings — cloud, no local model download.
# auto = Gemini when GEMINI_API_KEY is set, else the offline hash function.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
# Alternatives: EMBEDDING_PROVIDER=openai | hash
# Local model (opt-in, downloads multi-GB torch stack):
#   pip install sentence-transformers
#   EMBEDDING_PROVIDER=sentence-transformers
#   EMBEDDING_MODEL=BAAI/bge-m3

# Zero-Mem memory store (SQLite)
ZERO_MEM_DB=./data/zero_mem.db

# Optional: Gemini SLM extractor for Zero-Mem — adds relation triples
# (Van Tam -[OWNS]-> Do Luc) and unlisted entities on ingest. Free key at
# https://aistudio.google.com/apikey. Without a key the token-free
# gazetteer/pattern NER runs alone.
# GEMINI_API_KEY=
# Note: gemini-2.5-* is rejected for keys created after mid-2026 ("no longer
# available to new users") even though ListModels still returns it.
# ZERO_MEM_EXTRACT_MODEL=gemini-3.1-flash-lite
# ZERO_MEM_EXTRACTOR=auto

# Server
HOST=0.0.0.0
PORT=8000
