# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
GROQ_API_KEY=gsk_

# Ollama — use 'ollama' hostname when running with --profile with-ollama
OLLAMA_BASE_URL=http://ollama:11434

# Default LLM provider: claude | openai | groq | ollama
DEFAULT_LLM_PROVIDER=claude
DEFAULT_MODEL=claude-sonnet-4-20250514

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker (leave empty to disable)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
