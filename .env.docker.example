# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
GROQ_API_KEY=gsk_

# Ollama — use 'ollama' hostname when running with --profile with-ollama
OLLAMA_BASE_URL=http://ollama:11434

# Default LLM provider: claude | openai | groq | ollama
DEFAULT_LLM_PROVIDER=claude
DEFAULT_MODEL=claude-sonnet-4-20250514

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Zero-Mem memory store (SQLite)
ZERO_MEM_DB=/app/data/memory/zero_mem.db

# Saved chapters. MUST match the mounted volume in docker-compose.yml,
# otherwise chapters are written to the container layer and lost on restart.
CHAPTERS_DIR=/app/data/chapters
