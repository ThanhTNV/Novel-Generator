# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
GROQ_API_KEY=gsk_

# Ollama — use 'ollama' hostname when running with --profile with-ollama
OLLAMA_BASE_URL=http://ollama:11434

# Default LLM provider: claude | openai | groq | ollama
DEFAULT_LLM_PROVIDER=claude
DEFAULT_MODEL=claude-sonnet-4-20250514

# Embeddings — cloud, nothing downloaded into the image.
# auto = Gemini when GEMINI_API_KEY is set, else the offline hash function.
# Leave EMBEDDING_MODEL blank to take the provider's own default; naming a
# local model here (e.g. BAAI/bge-m3) while the provider resolves to Gemini
# sends that string to the Gemini API as a model id and every request 404s.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_DIMS=768

# Optional: Gemini powers both embeddings and the Zero-Mem SLM extractor
# (relation triples). Free key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY=

# Novel workspaces. Each novel keeps its own context/, chapters/ and
# memory/zero_mem.db under here, so retrieval for one book can never reach
# another. MUST match the mounted volume in docker-compose.yml, otherwise
# everything is written to the container layer and lost on restart.
NOVELS_DIR=/app/novels

# Workspace used when a request names no novel.
DEFAULT_NOVEL=default
