# Override environment variables for Docker deployment
# Copy this file to .env.docker and customize before running:
#   docker-compose --env-file .env.docker up -d

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
GROQ_API_KEY=gsk_

# Local model (Ollama) - use 'ollama' as hostname when running docker-compose with ollama service
OLLAMA_BASE_URL=http://ollama:11434

# Default LLM provider: claude | openai | groq | ollama
DEFAULT_LLM_PROVIDER=claude
DEFAULT_MODEL=claude-sonnet-4-20250514

# Embedding config
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=sentence-transformers

# Logging
LOG_LEVEL=INFO
